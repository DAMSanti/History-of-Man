# Godot 4.x specific ignores
.godot/

# Exported files
*.pck
*.exe
*.x86_64
*.x86_32
*.apk
*.aab

# Import files
.import/

# Export presets (uncomment if needed)
# export_presets.cfg

# Build output
builds/
export/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log

# Backup files
*.bak
*.backup

# El relieve: no se versiona NADA de data/dem, y son 667 MB. Se reconstruye
# entero por capas, cada una con su script:
#  - las teselas Terrarium las baja `DEMImporter` de AWS Terrain Tiles, que no
#    pide clave;
#  - el MDT de la región sale de esas teselas, y el recorte de cada
#    emplazamiento lo escribe `RegionMap` la primera vez que se abre;
#  - las mallas cacheadas las escribe `TerrainGenerator`.
data/dem/

# Texturas PBR del terreno: las trae y las empaqueta
# scripts/tools/TerrainTextureIngest.gd desde ambientCG (CC0). Son 34 MB que
# se reconstruyen solos, asi que se versiona el script y no el resultado.
textures/terrain/

# Modelos de props: los trae y los empaqueta scripts/tools/PropIngest.gd desde
# Poly Haven (CC0). Se reconstruyen solos, asi que se versiona el script.
models/props/

# Modelos que se sueltan a mano para la ingesta (asta, concha...). Se
# versiona el catalogo que los declara, no el binario.
models/props/source/

# La banda: el FBX de origen (CC0, Quaternius) y la textura de vertice
# horneada por scripts/tools/BandaAtlas.gd. Se reconstruyen solos, asi que
# se versiona el horneador y no 32 MB de animacion horneada.
models/people/

# La fauna: los FBX/GLB de origen (CC0, Quaternius/gobkit) y la textura de
# vertice horneada por scripts/tools/FaunaAtlas.gd. Mismo motivo.
models/animals/
