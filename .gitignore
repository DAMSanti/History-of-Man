# Godot 4.x specific ignores
.godot/

# Exported files
*.pck
*.exe
*.x86_64
*.x86_32
*.apk
*.aab

# Import files
.import/

# Export presets (uncomment if needed)
# export_presets.cfg

# Build output
builds/
export/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log

# Backup files
*.bak
*.backup

# Cachés de terreno: las regenera el propio juego al abrir un emplazamiento
# -TerrainGenerator las escribe, y son 558 MB-. Lo que NO se regenera es el
# MDT de origen, que va aparte.
data/dem/**/*_mesh_r*.res
data/dem/**/*_surround*.res
# Teselas descargadas del servicio de mapas
data/dem/tiles/

# Texturas PBR del terreno: las trae y las empaqueta
# scripts/tools/TerrainTextureIngest.gd desde ambientCG (CC0). Son 34 MB que
# se reconstruyen solos, asi que se versiona el script y no el resultado.
textures/terrain/

# Modelos de props: los trae y los empaqueta scripts/tools/PropIngest.gd desde
# Poly Haven (CC0). Se reconstruyen solos, asi que se versiona el script.
models/props/
