; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="History of Man"
config/description="Simulacion de una banda paleolitica en la Cantabria del Magdaleniense: subsistencia, tecnica y territorio sobre relieve real."
run/main_scene="res://scenes/menu_principal.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]


[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray()

[input]

; LAS TECLAS NO VIVEN AQUI. El catalogo esta en `scripts/vista/Teclas.gd`, que monta
; el InputMap al arrancar con lo que el jugador tenga guardado (INTERFAZ, seccion 11). Aqui
; habia cinco acciones -las cuatro de mover y el boton derecho de girar- y ninguna se
; usaba ya: la camara miraba la tecla fisica, y el boton derecho se lee a mano en
; `OrbitalCamera._unhandled_input`.

[layer_names]

3d_physics/layer_1="terrain"
3d_physics/layer_2="props"
3d_physics/layer_3="resources"
3d_physics/layer_4="banda"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=0
global_illumination/sdfgi/probe_ray_count=2
environment/defaults/default_clear_color=Color(0.301961, 0.301961, 0.301961, 1)
anti_aliasing/quality/use_taa=true
